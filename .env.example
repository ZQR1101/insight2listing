# Model provider configuration (backend only; always keep out of browser code and .git)
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=gpt-image-2
# OpenAI-compatible base URL — point this at a relay/中转 service if you use one
OPENAI_BASE_URL=https://api.openai.com/v1
# Image engine selection: auto (openai when a key exists) | mock | openai
IMAGE_PROVIDER=auto

# Application
APP_ENV=development
APP_LOCALE=zh-CN
# psycopg async driver against the docker-compose Postgres (mapped to host port 5050).
DATABASE_URL=postgresql+psycopg://insight2listing:insight2listing@localhost:5050/insight2listing
REDIS_URL=redis://localhost:6379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=insight2listing
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Upload guardrail
MAX_UPLOAD_BYTES=26214400

# Optional Amazon integration; not required for the initial local setup
AMAZON_SP_API_ENABLED=false
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER